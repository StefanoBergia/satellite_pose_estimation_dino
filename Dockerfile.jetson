# Jetson Orin – JetPack 6 (ARM64 only – build/run on Jetson, not x86_64)
# l4t-pytorch is discontinued for JetPack 6; use the unified igpu tag instead.
# For JetPack 5, use: nvcr.io/nvidia/l4t-pytorch:r35.2.1-pth2.0-py3
FROM nvcr.io/nvidia/pytorch:25.03-py3-igpu

# Extra packages not in the base image
# torch, numpy, onnxruntime-gpu already included in base
RUN pip install --no-cache-dir \
    timm>=0.9 \
    transformers>=4.36 \
    pyyaml \
    onnx>=1.14 \
    Pillow
